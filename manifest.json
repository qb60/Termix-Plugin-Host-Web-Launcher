{
  "id": "host-web-launcher",
  "name": "Host Web Launcher",
  "version": "1.0.2",
  "description": "Open host web interfaces directly in a new browser tab.",
  "author": {
    "name": "Host Web Launcher contributors"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/qb60/Termix-Plugin-Host-Web-Launcher",
  "category": "Networking",
  "icon": "Globe",
  "engine": {
    "termix": ">=26.10.3",
    "api": "^1.9"
  },
  "capabilities": ["ui:surface"],
  "contributes": {
    "settings": {
      "host": {
        "fields": [
          {
            "key": "enabled",
            "type": "boolean",
            "default": false,
            "labelKey": "enabled",
            "hidden": true
          },
          {
            "key": "label",
            "type": "string",
            "default": "Web",
            "defaultable": false,
            "labelKey": "label",
            "requires": "enabled",
            "hidden": true
          },
          {
            "key": "protocol",
            "type": "select",
            "default": "https",
            "options": [
              {
                "value": "http",
                "labelKey": "http"
              },
              {
                "value": "https",
                "labelKey": "https"
              }
            ],
            "labelKey": "protocol",
            "requires": "enabled",
            "hidden": true
          },
          {
            "key": "port",
            "type": "number",
            "min": 1,
            "max": 65535,
            "labelKey": "port",
            "requires": "enabled",
            "hidden": true
          },
          {
            "key": "path",
            "type": "string",
            "default": "/",
            "labelKey": "path",
            "requires": "enabled",
            "hidden": true
          },
          {
            "key": "hostname",
            "type": "string",
            "default": "",
            "defaultable": false,
            "descriptionKey": "hostnameHelp",
            "labelKey": "hostname",
            "requires": "enabled",
            "hidden": true
          },
          {
            "key": "endpoints",
            "type": "json",
            "labelKey": "endpoints",
            "defaultable": false,
            "hidden": true
          }
        ]
      }
    }
  },
  "frontend": "dist/frontend.js",
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"],
  "backend": "dist/backend.js"
}
